# PostgreSQL connection & authentication settings for internal server deployment
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="work_planner"
PG_CONNECTED="true"
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/work_planner?schema=public"

# Admin login credentials (employees do not need to log in)
ADMIN_USER="admin"
ADMIN_PASSWORD="change_me_admin_password"
AUTH_SECRET="change_me_random_secret_key"

